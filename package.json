{
  "name": "enspace-prototipos",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node ferramentas/conferir-sdk.js --aviso && nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "atualizar": "pnpm dlx taze major -I -i && node ferramentas/conferir-sdk.js",
    "atualizar:sdk": "pnpm dlx taze major -I -i -n \"@be-enlighten/*\" && node ferramentas/conferir-sdk.js",
    "conferir": "node ferramentas/conferir-sdk.js",
    "conferir:remoto": "node ferramentas/conferir-sdk.js --remoto",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@be-enlighten/beni-avatar": "^0.4.2",
    "@be-enlighten/enspace-sdk-core": "^0.17.0",
    "@be-enlighten/enspace-sdk-schemas": "^0.17.0",
    "@be-enlighten/enspace-sdk-ui": "^0.17.0",
    "@be-enlighten/enspace-sdk-vue": "^0.17.0",
    "@iconify-json/lucide": "^1.2.140",
    "@iconify-json/simple-icons": "^1.2.99",
    "@nuxt/ui": "^4.5.1",
    "@tanstack/vue-table": "^8.21.3",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-emoji": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extension-subscript": "3.31.4",
    "@tiptap/extension-superscript": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-text-align": "3.31.4",
    "@tiptap/extension-text-style": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@unovis/ts": "^1.7.1",
    "@unovis/vue": "^1.7.1",
    "marked": "^18.1.0",
    "nuxt": "^4.4.2"
  },
  "packageManager": "pnpm@10.6.5"
}
